# Kopyalayın: cp .env.example .env  (.env git'e GİRMEZ)

# HuggingFace — dataset public ama token rate limit'i rahatlatır
HF_TOKEN=

# W&B KULLANILMADI (2026-09-20 denetimi). Koşu kaydı JSON: her koşu
# `reports/results/*.json` içine config, seed, metrik ve `code_version` yazıyor.
# Anahtarlar burada duruyordu ama kodda tek bir `wandb` çağrısı yok.

# HF model/dataset cache yolu (opsiyonel, disk yönetimi için)
HF_HOME=./.hf_cache
