# Kopyalayın: cp .env.example .env  (.env git'e GİRMEZ)

# HuggingFace — dataset public ama token rate limit'i rahatlatır
HF_TOKEN=

# Weights & Biases — deney takibi (ücretsiz hesap)
WANDB_API_KEY=
WANDB_PROJECT=gift-contamination
WANDB_ENTITY=

# HF model/dataset cache yolu (opsiyonel, disk yönetimi için)
HF_HOME=./.hf_cache
